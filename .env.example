APP_BIND=0.0.0.0:8080
REALTIME_TCP_BIND=0.0.0.0:8081
REALTIME_TCP_PUBLIC=tcp://localhost:8081
REALTIME_WSS_PUBLIC=ws://localhost:8080/v1/realtime/connect
APP_ENV=sandbox
DATABASE_URL=postgres://chat:chat@localhost:5432/chat
REDIS_URL=redis://localhost:6379
BUSINESS_SOLUTIONS_URL=http://localhost:50056
SCYLLA_NODES=127.0.0.1:9042
KAFKA_BROKERS=127.0.0.1:19092
JWT_SECRET=replace-with-at-least-32-random-bytes
OTP_HMAC_SECRET=replace-with-an-independent-random-secret
OTP_DEV_ECHO=true
SNOWFLAKE_NODE_ID=0
SERVER_STATIC_KEY=replace-with-base64-encoded-x25519-private-key
RUST_LOG=chat_server=info,tower_http=info
