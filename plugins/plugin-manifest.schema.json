{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tektalk.vn/schemas/plugin-manifest-v1.json",
  "title": "TEKtalk Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "entryPoint", "minimumHostVersion", "capabilities", "tab"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{2,63}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "entryPoint": {"type": "string", "minLength": 1},
    "minimumHostVersion": {"type": "string"},
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["camera", "location", "media-picker", "notifications", "secure-storage", "share"]}
    },
    "tab": {
      "type": "object",
      "additionalProperties": false,
      "required": ["titleKey", "icon", "order"],
      "properties": {
        "titleKey": {"type": "string"},
        "icon": {"type": "string"},
        "order": {"type": "integer", "minimum": 0}
      }
    }
  }
}
